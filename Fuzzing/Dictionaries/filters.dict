# libFuzzer dictionary for the filters target. The first input byte selects the filter (modulo 13) and the second
# byte selects its options (and seeds the chunking pattern), so the entries below are interesting raw input bytes.

"\x0D\x0A"
"\x0D"
"\x0A"
"\x0D\x0D\x0A"
" \x0D\x0A"
"\x09\x0D\x0A"
" \x09"
"\x00"
"\xE9"
"From "
"\x0AFrom "
">From "
"\x0A>From "
"-----BEGIN PGP MESSAGE-----"
"-----END PGP MESSAGE-----"
"-----BEGIN PGP SIGNED MESSAGE-----"
"-----BEGIN PGP SIGNATURE-----"
"-----END PGP SIGNATURE-----"
"-----BEGIN PGP PUBLIC KEY BLOCK-----"
"-----END PGP PUBLIC KEY BLOCK-----"
"-----BEGIN PGP PRIVATE KEY BLOCK-----"
"-----END PGP PRIVATE KEY BLOCK-----"
"Hash: SHA256"
