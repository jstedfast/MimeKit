# libFuzzer dictionary for the encoders target. The first input byte selects the encoder (modulo 9) and the second
# byte selects the line length (and seeds the chunking pattern), so the entries below are interesting raw input bytes.

"\x0D\x0A"
"\x0D"
"\x0A"
" \x0D\x0A"
"\x09\x0D\x0A"
" \x0A"
"\x09\x0A"
"\x0D\x0D\x0A"
"="
"=\x0A"
"."
"\x00"
"\x7F"
"\xFF"
"_"
"?"
"%"
"From "