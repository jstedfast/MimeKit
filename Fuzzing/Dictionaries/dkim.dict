# libFuzzer dictionary for the dns-records, dkim-arc-verifier and dmarc-verifier targets.

# FuzzDnsZone syntax (see Fuzzing/Helpers/FuzzDnsZone.cs).
"%%\x0a"
"!nxdomain"
"!tempfail"
"!empty"
"!throw"
"!null"
"@spf pass "
"@spf fail "
"@spf softfail "
"@spf temperror "
"._domainkey."
"_dmarc."

# Tag-value lists.
";"
"="
":"
","
" "
"v=DKIM1"
"v=DMARC1"
"k=rsa"
"k=ed25519"
"h=sha256"
"h=sha1"
"p="
"s=email"
"s=*"
"t=y"
"t=s"
"t=y:s"
"n="

# DMARC records.
"p=none"
"p=quarantine"
"p=reject"
"sp="
"np="
"adkim=r"
"adkim=s"
"aspf=r"
"aspf=s"
"pct="
"fo="
"rf=afrf"
"ri="
"rua=mailto:"
"ruf=mailto:"
"psd=y"
"psd=n"
"psd=u"

# DKIM-Signature / ARC tags.
"DKIM-Signature:"
"ARC-Seal:"
"ARC-Message-Signature:"
"ARC-Authentication-Results:"
"a=rsa-sha256"
"a=rsa-sha1"
"a=ed25519-sha256"
"b="
"bh="
"c=simple/simple"
"c=relaxed/relaxed"
"c=relaxed/simple"
"c=simple/relaxed"
"d="
"h=from:to:subject"
"i=1"
"i=@"
"l="
"q=dns/txt"
"s="
"t="
"x="
"z="
"cv=none"
"cv=pass"
"cv=fail"
"\x0d\x0a\x09"
"From: "
"\x0a\x0a"

# Public key prefixes (RSA SubjectPublicKeyInfo / PKCS#1 and Ed25519).
"MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQ"
"MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA"
"MIGJAoGB"
"IDAQAB"
"11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo="
